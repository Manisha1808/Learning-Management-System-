<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <title>@ViewBag.Title - LMS</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @Styles.Render("~/Content/css")

    <link rel="stylesheet"
          href="https://code.jquery.com/ui/1.13.2/themes/smoothness/jquery-ui.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/free-jqgrid@4.15.5/css/ui.jqgrid.min.css" />
    <style>

        body {
            margin: 0;
            padding-top: 0;
            font-family: Arial, sans-serif;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .admin-sidebar {
            width: 220px;
            background-color: #5b9bd5;
            padding: 30px 20px;
            box-sizing: border-box;
        }

        .sidebar-btn {
            display: block;
            background-color: white;
            color: #222;
            text-decoration: none;
            padding: 10px;
            margin-bottom: 15px;
            border: 1px solid #222;
            width: 150px;
        }

            .sidebar-btn:hover {
                background-color: white;
                text-decoration: none;
                color: grey;
            }

        .admin-main {
            flex: 1;
            padding: 5px 30px 30px 30px;
        }
        .ui-dialog-titlebar {
            display: none;
        }
        .ui-dialog-buttonpane {
            border-top: none !important;
        }
        .ui-dialog {
            width: 300px !important;
        }

        .ui-dialog-content {
            padding: 15px !important;
        }
        .dashboard-header {
            position: relative;
            min-height: 50px;
        }

            .dashboard-header h2 {
                text-align: center;
                margin: 0;
            }

        .manage-profile-btn {
            position: absolute;
            top: 0;
            right: 10px;
            width: 100px;
            padding: 8px 0;
            background: #5b9bd5;
            color: white;
            text-align: center;
            text-decoration: none;
        }
    </style>

</head>

<body>

    <div class="admin-wrapper">

        @Html.Partial("_AdminSidebar")

        <div class="admin-main">

            @RenderBody()

        </div>

    </div>
    @Scripts.Render("~/bundles/jquery")
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    @Scripts.Render("~/bundles/bootstrap")


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/free-jqgrid@4.15.5/css/ui.jqgrid.min.css" />

    <script src="https://cdn.jsdelivr.net/npm/free-jqgrid@4.15.5/js/jquery.jqgrid.min.js"></script>


    @RenderSection("scripts", required: false)
</body>
</html>