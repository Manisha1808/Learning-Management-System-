<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - LMS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @Styles.Render("~/Content/css")
    <style>
        body {
            margin: 0;
            padding-top: 50px;
            font-family: Arial, sans-serif;
        }
        .navbar-container {
            width: 90%;
            margin: auto;
            height: 50px;
            display: flex;
            align-items: center;
        }
        .navbar-brand {
            color: blue;
            text-decoration: none;
            font-size: 18px;
            margin-right: 30px;
        }
        .navbar-link {
            color: #9d9d9d;
            text-decoration: none;
            margin-right: 25px;
        }
            .navbar-link:hover {
                color: white;
                text-decoration: none;
            }
        .admin-wrapper {
            display: flex;
            min-height: calc(100vh - 50px);
        }
        .admin-sidebar {
            width: 220px;
            background-color: #5b9bd5;
            padding: 30px 20px;
            box-sizing: border-box;
        }
        .sidebar-btn {
            display: block;
            background-color: white;
            color: #222;
            text-decoration: none;
            padding: 10px;
            margin-bottom: 15px;
            border: 1px solid #222;
            width: 150px;
        }
            .sidebar-btn:hover {
                background-color: white;
                text-decoration: none;
                color: grey;          }

        .admin-main {
            flex: 1;
            padding: 30px;
        }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        @Html.Partial("_AdminSidebar")
        <div class="admin-main">
            @RenderBody()
        </div>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
