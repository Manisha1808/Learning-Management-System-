<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>@ViewBag.Title - LMS</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @Styles.Render("~/Content/css")

    <style>
        body {
            margin: 0;
            padding-top: 50px;
            font-family: Arial, sans-serif;
        }

        /* =========================
           TOP NAVBAR
           ========================= */

        .top-navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 50px;
            background-color: #222;
            z-index: 1000;
        }

        .navbar-container {
            width: 90%;
            margin: auto;
            height: 50px;
            display: flex;
            align-items: center;
        }

        .navbar-brand {
            color: #9d9d9d;
            text-decoration: none;
            font-size: 18px;
            margin-right: 30px;
        }

        .navbar-link {
            color: #9d9d9d;
            text-decoration: none;
            margin-right: 25px;
        }

            .navbar-link:hover {
                color: white;
                text-decoration: none;
            }


        /* =========================
           ADMIN AREA
           ========================= */

        .admin-wrapper {
            display: flex;
            min-height: calc(100vh - 50px);
        }


        /* =========================
           SIDEBAR
           ========================= */

        .admin-sidebar {
            width: 220px;
            background-color: #5b9bd5;
            padding: 30px 20px;
            box-sizing: border-box;
        }

        .sidebar-btn {
            display: block;
            background-color: white;
            color: #222;
            text-decoration: none;
            padding: 10px;
            margin-bottom: 15px;
            border: 1px solid #222;
            width: 150px;
        }

            .sidebar-btn:hover {
                background-color: #f2f2f2;
                text-decoration: none;
                color: #222;
            }


        /* =========================
           MAIN CONTENT
           ========================= */

        .admin-main {
            flex: 1;
            padding: 30px;
        }
    </style>
</head>

<body>

    <!-- =========================
         TOP NAVBAR
         ========================= -->

    <nav class="top-navbar">

        <div class="navbar-container">

            <a href="@Url.Action("Index", "Home", new { area = "" })"
               class="navbar-brand">
                LMS
            </a>

            <a href="@Url.Action("Index", "Home", new { area = "" })"
               class="navbar-link">
                Home
            </a>

            <a href="@Url.Action("About", "Home", new { area = "" })"
               class="navbar-link">
                About
            </a>

            <a href="@Url.Action("Contact", "Home", new { area = "" })"
               class="navbar-link">
                Contact
            </a>

        </div>

    </nav>


    <!-- =========================
         ADMIN CONTENT
         ========================= -->

    <div class="admin-wrapper">

        <!-- SIDEBAR -->
        @Html.Partial("_AdminSidebar")


        <!-- PAGE CONTENT -->
        <div class="admin-main">

            @RenderBody()

        </div>

    </div>


    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>
</html>