@model LMS.Areas.Admin.Models.RegisterUser
<link href="~/Content/style.css" rel="stylesheet" />

<h2> Registration Form </h2>

@using (Html.BeginForm("RegisterUser", "Admin", FormMethod.Post, new { id = "registerForm" }))
{
    <div class="form-group">
        <label><span>*</span> First Name</label>
        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.FirstName,"",new { @class = "validation-message" })
    </div>

    <div class="form-group">
        <label><span>*</span> Last Name</label>
        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.LastName,"",new { @class = "validation-message" })
    </div>

    <div class="form-group">
        <label><span>*</span> Email</label>
        @Html.TextBoxFor(m => m.Email,new { @class = "form-control", type = "email" })
        @Html.ValidationMessageFor(m => m.Email,"",new { @class = "validation-message" })
    </div>

    <div class="form-group">
        <label><span>*</span> Password</label>
        @Html.PasswordFor(m => m.Password,new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Password,"",new { @class = "validation-message" })
    </div>

    <div class="form-group">
        <label><span>*</span> Role</label>
        @Html.DropDownListFor(m => m.Role,new List<SelectListItem>
            {
                new SelectListItem { Text = "Admin", Value = "1" },
                new SelectListItem { Text = "Employee", Value = "2" }
            },"-- Select Role --",new { @class = "form-control", id = "Role" })
        @Html.ValidationMessageFor(m => m.Role,"",new { @class = "validation-message" })
    </div>

    <div id="courseDiv" class="form-group" style="display:none;">
        <label><span>*</span> Course</label>
        @Html.DropDownListFor(m => m.CourseId,new List<SelectListItem>
            {
                new SelectListItem { Text = "MVC", Value = "1" },
                new SelectListItem { Text = "Azure", Value = "2" }
            },"-- Select Course --",new { @class = "form-control", id = "Course" })
        @Html.ValidationMessageFor(m => m.CourseId,"",new { @class = "validation-message" })
    </div>

    <div class="button-container">
        <button type="submit" class="btn-create">
            Create User
        </button>

        <button type="button" class="btn-create"
                onclick="window.location.href='@Url.Action("Dashboard", "Admin", new { area = "Admin" })'">
            Back
        </button>
    </div>
 }

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Scripts/admin.js"></script>