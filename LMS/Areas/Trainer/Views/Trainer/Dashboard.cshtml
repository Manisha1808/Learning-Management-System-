@model LMS.Areas.Trainer.Models.EmployeeProgress

@{
    ViewBag.Title = "Trainer Dashboard";
    Layout = "~/Areas/Trainer/Views/Shared/_Layout.cshtml";
}

<center>
    <h3>Trainer Dashboard</h3>
</center>

<br />

<div>
    <input type="text"
           id="txtSearchEmployee"
           placeholder="Search Name or Email"
           class="form-control"
           style="width:250px; display:inline-block;" />

    <select id="ddlStatus"
            class="form-control"
            style="width:180px; display:inline-block;">
        <option value="">All Status</option>
        @foreach (var status in ViewBag.Statuses)
        {
            <option value="@status.Value">@status.Text</option>
        }
    </select>
    <input type="date"
           id="txtEnrollmentFrom"
           class="form-control"
           style="width:180px; display:inline-block;" />

    <input type="date"
           id="txtEnrollmentTo"
           class="form-control"
           style="width:180px; display:inline-block;" />

    <button type="button"
            id="btnSearchEmployee"
            class="btn btn-primary"
            title="Search">
        <i class="fas fa-search"></i>
    </button>

    <button type="button"
            id="btnClearEmployee"
            class="btn btn-default"
            title="Clear">
        <i class="fas fa-times"></i>
    </button>

</div>

<br />
<table id="employeeTable"
       class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>User Name</th>
            <th>Course Name</th>
            <th>Status</th>
            <th>Videos Completed</th>
            <th>Progress %</th>
        </tr>
    </thead>

    <tbody>
    </tbody>

</table>
@section scripts
{
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {

            var table = $("#employeeTable").DataTable({
                ajax: {
                    url: "/Trainer/Trainer/GetEmployeeList",
                    type: "GET",
                    data: function (d) {
                        d.SearchText = $("#txtSearchEmployee").val();
                        d.StatusFilter = $("#ddlStatus").val();
                        d.EnrollmentFrom = $("#txtEnrollmentFrom").val();
                        d.EnrollmentTo = $("#txtEnrollmentTo").val();
                    },
                    dataSrc: "rows"
                },

                columns: [
                    { data: "UserName" },
                    { data: "CourseName" },
                    { data: "Status" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return row.CompletedVideos + " / " + row.TotalVideos;
                        }
                    },
                    {
                        data: "ProgressPercentage",
                        render: function (data) {
                            return data + "%";
                        }
                    }
                ],

                pageLength: 10,

                lengthMenu: [5, 10, 25, 50],

                searching: false,

                ordering: true,

                info: true
            });


            // SEARCH
            $("#btnSearchEmployee").click(function () {
                table.ajax.reload();
            });


            // CLEAR
            $("#btnClearEmployee").click(function () {

                $("#txtSearchEmployee").val("");
                $("#ddlStatus").val("");
                $("#txtEnrollmentFrom").val("");
                $("#txtEnrollmentTo").val("");

                table.ajax.reload();
            });

        });
    </script>
}