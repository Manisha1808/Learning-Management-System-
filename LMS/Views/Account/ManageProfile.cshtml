@model LMS.Models.ManageProfile
@{
    ViewBag.Title = "ManageProfile";
    Layout = "~/Views/Shared/_Layout.cshtml";
 }
<style>
    #messageDialog {
        position: fixed;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 300px;
        padding: 20px;
        background-color: white;
        border: 1px solid #ccc;
        text-align: center;
    }

    #messageText {
        margin-bottom: 20px;
    }

    #btnOk {
        padding: 6px 10px;
    }
</style>
<h2>Manage Profile</h2>

<div style="width:400px;">

    <div>
        <label>First Name</label>
        <input type="text"
               id="txtFirstName"
               class="form-control"
               value="@Model.FirstName" />
    </div>
    <br />
    <div>
        <label>Last Name</label>
        <input type="text"
               id="txtLastName"
               class="form-control"
               value="@Model.LastName" />
    </div>
    <br />
    <div>
        <label>Email</label>
        <input type="text"
               id="txtEmail"
               class="form-control"
               value="@Model.Email" />
    </div>
    <br />
    <div>
        <label>Phone Number </label>
        <input type="text"
               id="txtPhoneNumber"
               class="form-control"
               value="@Model.PhoneNumber" />

        <span id="phoneError" style="color:red;"></span>
    </div>
    <br />
    <div>
        <label>
            Created By
            @Model.CreatedBy
        </label>

    </div>

    <div>
        <label>
            Created Date
            @Model.CreatedDate
        </label>

    </div>
    </br>
    <button type="button"
            id="btnSaveProfile"
            class="btn btn-success">
        Save
    </button>

</div>

<div id="messageDialog" style="display:none;">
    <p id="messageText"></p>
    <button type="button" id="btnOk">OK</button>
</div>

@section scripts
{
    <script>
        $(document).ready(function () {
            function showMessage(message) {
                $("#messageText").text(message);
                $("#messageDialog").show();
            }

            $("#btnOk").click(function () {
                $("#messageDialog").hide();
            });
            $("#btnSaveProfile").click(function () {
                var phone = $("#txtPhoneNumber").val().trim();
                if (phone !== "" && !/^[6-9][0-9]{9}$/.test(phone)) {
                    $("#phoneError").text("Enter a valid 10-digit phone number.");
                    return;
                }
                $.ajax({
                      url: '@Url.Action("ManageProfile", "Account", new { area = "" })',
                    type: "POST",
                    data: {
                        FirstName: $("#txtFirstName").val(),
                        LastName: $("#txtLastName").val(),
                        Email: $("#txtEmail").val(),
                        PhoneNumber: $("#txtPhoneNumber").val()
                    },
                    success: function (response) {
                        if (response.success) {showMessage(response.message); }
                        else { showMessage("Profile update failed."); }
                    },
                    error: function () {showMessage("Error while updating profile."); }
                });

            });

        });

    </script>
}